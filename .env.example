# ---------------------------------------------------------------------------
# Active Local — environment variables. Every variable is OPTIONAL.
# The app runs fully with no configuration (SQLite + local email outbox).
# ---------------------------------------------------------------------------

# Weekly digest emails. When unset, emails are written to var/outbox/ instead.
RESEND_API_KEY=
# From address for digest emails. Resend's free tier only allows your own address.
EMAIL_FROM="Active Local <digest@example.com>"

# Protects /api/cron/weekly-digest. Vercel Cron sends it automatically when set
# as CRON_SECRET in your Vercel project environment variables.
CRON_SECRET=change-me

# Public site URL, used in digest emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
